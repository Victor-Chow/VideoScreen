<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FF000000">

    <!-- Video Player -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:show_buffering="when_playing"
            app:use_controller="false" />

        <TextView
            android:id="@+id/tvNoVideo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/no_video"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:visibility="visible" />

    </FrameLayout>

    <!-- Zoomable SeekBar -->
    <com.screenshot.app.ZoomableSeekBar
        android:id="@+id/seekBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingHorizontal="8dp" />

    <!-- Time display -->
    <TextView
        android:id="@+id/tvTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:paddingVertical="4dp"
        android:background="#CC000000" />

    <!-- Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingVertical="8dp"
        android:paddingHorizontal="12dp"
        android:background="#CC000000">

        <Button
            android:id="@+id/btnOpen"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="@string/open_video"
            android:textColor="@color/white"
            app:strokeColor="@color/white"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnScreenshot"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="@string/screenshot"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnSave"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:backgroundTint="@color/accent"
            android:text="@string/save_all"
            android:layout_marginEnd="8dp" />

        <Spinner
            android:id="@+id/spinnerDevice"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:popupBackground="#FF333333" />

        <ImageButton
            android:id="@+id/btnAddDevice"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@android:drawable/ic_input_add"
            android:contentDescription="@string/add_device"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white" />

        <ImageButton
            android:id="@+id/btnDeleteDevice"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@android:drawable/ic_menu_delete"
            android:contentDescription="@string/delete_device"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white" />

    </LinearLayout>

    <!-- Thumbnail strip -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="#CC000000">

        <LinearLayout
            android:id="@+id/thumbnailStrip"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="4dp"
            android:gravity="center_vertical" />

    </HorizontalScrollView>

</LinearLayout>
